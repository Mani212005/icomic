{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icomic.local/contracts/schemas/credit.schema.json",
  "title": "CreditLedgerEvent",
  "description": "Schema for credit ledger debit, refund, and balance adjustment records in Icomic",
  "type": "object",
  "required": [
    "id",
    "user_id",
    "project_id",
    "generation_job_id",
    "transaction_type",
    "amount",
    "balance_after",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the ledger transaction"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning user UUID"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "description": "Associated project UUID"
    },
    "generation_job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Associated generation job UUID"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "debit",
        "refund",
        "adjustment"
      ],
      "description": "Classification of the transaction"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Transaction amount in USD / credit units"
    },
    "balance_after": {
      "type": "number",
      "description": "Computed credit balance after applying the transaction"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when transaction was committed"
    }
  },
  "additionalProperties": false
}
